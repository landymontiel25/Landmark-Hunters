# Dependencies
node_modules

# Generated by `cap sync` for SPM packages configured with symlink: true
# (see capacitor.config.json) -- an absolute-path symlink into node_modules
# on whichever machine ran the sync, not something to share across machines.
ios/App/CapApp-SPM/symlinks/

# Build output
dist

# Secrets — never commit these
.env
.env.local
.env.*.local
# Service-account / private keys
*-key.json
firebase-key.json
*service-account*.json

# Vercel
.vercel

# Misc
.DS_Store
*.log
npm-debug.log*

# Local Claude Code permission allowlist -- personal to each machine/session,
# not project config that should be shared.
.claude/settings.local.json

# OSM import working files (raw Overpass/Wikidata/Commons replies)
scripts/osm-import/data/
