rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Mirrors isAdmin() in firestore.rules: a verified email on the list.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['landymontiel25@gmail.com'];
    }

    // Every upload path ends in a file name that starts with the uploader's
    // uid: {uid}.jpg, {uid}_{n}.jpg or {uid}_{timestamp}.jpg (see
    // reviews.js, leaderboard.js, customLandmarks.js). Before, any signed-in
    // account could overwrite or delete anyone's photo at the same path.
    function ownsFile(fileName) {
      return request.auth != null && fileName.matches(request.auth.uid + '(_[0-9]+)?[.]jpg');
    }

    // Real raster image types only, under 8 MB. No SVG (it can carry
    // script), no HTML, nothing executable.
    // Whose photo a file is: check-in and rating photos are named
    // {uid}_{digits}.jpg.
    function photoOwner(fileName) {
      return fileName.split('[_.]')[0];
    }
    // Who may read someone's check-in or rating photos (anti-farming item 7,
    // 2026-11-23): the owner, the admin, a friend, or anyone signed in when
    // the owner's profile is public and the owner hasn't blocked them.
    // (A saved download URL carries its own token and is shared only
    // through the check-in and rating docs, which firestore.rules gates,
    // blocks included.)
    //
    // At most 2 Firestore lookups (owner, 2026-11-23): production Storage
    // rules allow only 2 firestore.get/exists calls per request, and a
    // third makes the whole request fail (measured live; the emulator
    // doesn't enforce it). The earlier version made up to 4 (profile,
    // friend, a block each way), so friends and public-profile viewers
    // were refused. Order matters: profile, then the owner's block, then
    // friend. Public and not blocked: 2. Private, a friend: 2. Public and
    // blocked: the friend lookup would be a third, which refuses, the
    // right answer for a blocked viewer.
    function canSeePhotosOf(uid) {
      return request.auth != null
        && (request.auth.uid == uid
          || isAdmin()
          || (firestore.get(/databases/(default)/documents/users/$(uid)).data.get('public', false) == true
              && !firestore.exists(/databases/(default)/documents/blocks/$(uid + '_' + request.auth.uid)))
          || firestore.exists(/databases/(default)/documents/friend_edges/$(request.auth.uid + '_' + uid)));
    }

    function isImageUpload() {
      return isImageUploadUnder(8);
    }
    function isImageUploadUnder(mb) {
      return request.resource.size < mb * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif)');
    }

    // A tip's one optional photo (Phase 1), under the author's own folder,
    // images under 5 MB. api/post-tip.js only accepts a URL in the caller's
    // own folder. Create only, never overwritten or deleted by a client, so
    // the image behind a posted (or reviewed) tip can't be swapped. The
    // server removes a photo with its tip, and the whole folder on account
    // deletion; the admin can remove one.
    match /tip_photos/{uid}/{fileName} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        // An overwrite of an existing file is also checked as a create in
        // the emulator, so "no existing file" is spelled out.
        && resource == null
        && fileName.matches('[A-Za-z0-9_-]{1,80}[.]jpg')
        && isImageUploadUnder(5);
      allow update: if false;
      allow delete: if isAdmin();
    }
    // Profile pictures (owner, 2026-11-14): avatars/{uid}.jpg, the owner's
    // own file only, images under 5 MB. Any signed-in account can view one
    // (friends, leaderboards); nobody can list them.
    match /avatars/{fileName} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && isImageUploadUnder(5);
      allow delete: if (request.auth != null && fileName == request.auth.uid + '.jpg') || isAdmin();
    }
    match /review_photos/{landmarkId}/{fileName} {
      // get only: no list, so a signed-in user can not enumerate every
      // uploaded photo path (the app only ever opens a known download URL).
      allow get: if canSeePhotosOf(photoOwner(fileName));
      allow create, update: if ownsFile(fileName) && isImageUpload();
      // Split from create/update: request.resource is null on a delete.
      allow delete: if ownsFile(fileName) || isAdmin();
    }
    match /checkin_photos/{landmarkId}/{fileName} {
      // get only: no list, so a signed-in user can not enumerate every
      // uploaded photo path (the app only ever opens a known download URL).
      allow get: if canSeePhotosOf(photoOwner(fileName));
      allow create, update: if ownsFile(fileName) && isImageUpload();
      allow delete: if ownsFile(fileName) || isAdmin();
    }
    match /landmark_photos/{landmarkId}/{fileName} {
      // get only: no list, so a signed-in user can not enumerate every
      // uploaded photo path (the app only ever opens a known download URL).
      allow get: if request.auth != null;
      allow create, update: if ownsFile(fileName) && isImageUpload();
      allow delete: if ownsFile(fileName) || isAdmin();
    }
  }
}
