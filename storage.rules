rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Mirrors isAdmin() in firestore.rules: a verified email on the list.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['landymontiel25@gmail.com'];
    }

    // Every upload path ends in a file name that starts with the uploader's
    // uid: {uid}.jpg, {uid}_{n}.jpg or {uid}_{timestamp}.jpg (see
    // reviews.js, leaderboard.js, customLandmarks.js). Before, any signed-in
    // account could overwrite or delete anyone's photo at the same path.
    function ownsFile(fileName) {
      return request.auth != null && fileName.matches(request.auth.uid + '(_[0-9]+)?[.]jpg');
    }

    // Real raster image types only, under 8 MB. No SVG (it can carry
    // script), no HTML, nothing executable.
    function isImageUpload() {
      return isImageUploadUnder(8);
    }
    function isImageUploadUnder(mb) {
      return request.resource.size < mb * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif)');
    }

    // A tip's one optional photo (Phase 1), under the author's own folder,
    // images under 5 MB. api/post-tip.js only accepts a URL in the caller's
    // own folder. No overwrite: an uploaded photo can't be swapped for
    // another image behind a posted (or reviewed) tip. The owner may delete
    // one (an upload whose tip never posted); a new upload at the same name
    // gets a new download token, so a posted tip's URL then shows nothing,
    // never a different image.
    match /tip_photos/{uid}/{fileName} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && resource == null
        && fileName.matches('[A-Za-z0-9_-]{1,80}[.]jpg')
        && isImageUploadUnder(5);
      allow update: if false;
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }
    match /review_photos/{landmarkId}/{fileName} {
      // get only: no list, so a signed-in user can not enumerate every
      // uploaded photo path (the app only ever opens a known download URL).
      allow get: if request.auth != null;
      allow create, update: if ownsFile(fileName) && isImageUpload();
      // Split from create/update: request.resource is null on a delete.
      allow delete: if ownsFile(fileName) || isAdmin();
    }
    match /checkin_photos/{landmarkId}/{fileName} {
      // get only: no list, so a signed-in user can not enumerate every
      // uploaded photo path (the app only ever opens a known download URL).
      allow get: if request.auth != null;
      allow create, update: if ownsFile(fileName) && isImageUpload();
      allow delete: if ownsFile(fileName) || isAdmin();
    }
    match /landmark_photos/{landmarkId}/{fileName} {
      // get only: no list, so a signed-in user can not enumerate every
      // uploaded photo path (the app only ever opens a known download URL).
      allow get: if request.auth != null;
      allow create, update: if ownsFile(fileName) && isImageUpload();
      allow delete: if ownsFile(fileName) || isAdmin();
    }
  }
}
