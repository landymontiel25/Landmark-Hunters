    "test": "cd .. && npx vitest run mapr-synthetic-trainer/test"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.0",
    "papaparse": "^5.5.3",
    "ws": "^8.18.3"
  }
}
