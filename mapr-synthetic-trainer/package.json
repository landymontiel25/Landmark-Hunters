{
  "name": "mapr-synthetic-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline synthetic-user training and evaluation of Mapr Phase 1 (NCF, similarity, tag scores). Never touches production.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.js",
    "train": "node pipeline.js",
    "quick": "node pipeline.js --quick",
