rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The admin account(s). Mirrors ADMIN_EMAILS in src/lib/admins.js.
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['landymontiel25@gmail.com'];
    }

    // A friend request from `fromUid` to `toUid` is waiting. Its id is
    // always "{from}_{to}" (see friend_requests below).
    function pendingRequest(fromUid, toUid) {
      let path = /databases/$(database)/documents/friend_requests/$(fromUid + '_' + toUid);
      return exists(path) && get(path).data.from == fromUid && get(path).data.to == toUid;
    }

    // Largest single payout the app ever makes: one check-in (100) or one
    // referral bonus (50). Keeps a hand-crafted write from minting points.
    function maxPointsPerWrite() {
      return 100;
    }

    // Shared by reviews/{reviewId}/replies below -- same visibility a
    // review itself has (its own read rule, duplicated here since a
    // subcollection's rules can't reference a sibling match block).
    function reviewVisible(reviewId) {
      let review = get(/databases/$(database)/documents/reviews/$(reviewId));
      return (exists(/databases/$(database)/documents/users/$(review.data.userId))
          && get(/databases/$(database)/documents/users/$(review.data.userId)).data.get('public', false) == true)
        || (request.auth != null
            && (reviewId.split('_')[0] == request.auth.uid
                || exists(/databases/$(database)/documents/friend_edges/$(request.auth.uid + '_' + review.data.userId))));
    }

    // A review's `hidden` flag must always equal "reported by 2+ people" --
    // written by the author and by reporters alike, so neither side can
    // hide or un-hide a review on their own. It exists so a list query can
    // filter hidden reviews out (see the reviews list rule).
    function reviewHiddenOk(data) {
      return data.get('hidden', false) == (data.get('reportedBy', []).size() >= 2);
    }

    // The author's own copy of their profile privacy, for list queries.
    function reviewVisibilityOk(data) {
      return data.get('visibility', 'private') in ['public', 'private'];
    }

    // --- Existing production rules, kept as-is (stricter than the new
    // defaults below): public read, ownership-validated writes, immutable
    // checkins, and leaderboard entries locked to their own owner. ---
    match /checkins/{checkinId} {
      allow read: if true;
      // Repeat check-ins to the same landmark are real now -- visit #1 keeps
      // the original uid_landmarkId doc id (so every existing check-in stays
      // valid untouched); visit #2 onward is uid_landmarkId_<visitNumber>.
      // Fields and point values are pinned to what claimCheckIn writes, so a
      // direct database call can't mint a 1,000,000-point check-in.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && (
          checkinId == request.auth.uid + '_' + request.resource.data.landmarkId
          || checkinId.matches(request.auth.uid + '_' + request.resource.data.landmarkId + '_[0-9]+')
        )
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'landmarkId', 'landmarkName', 'region',
             'points', 'basePoints', 'visitNumber', 'ratingOnly', 'visited', 'insideHomeRadius', 'createdAt'])
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.points <= maxPointsPerWrite()
        && request.resource.data.get('basePoints', 0) is number
        && request.resource.data.get('basePoints', 0) <= maxPointsPerWrite()
        && request.resource.data.get('userName', '') is string
        && request.resource.data.get('userName', '').size() <= 200
        && request.resource.data.createdAt == request.time;
      // Owner may update ONLY photoURL / photoURLs / userName (own check-in
      // photos via addCheckinPhoto/removeCheckinPhoto, the legacy single
      // attachCheckinPhoto, email->username backfill via backfillUserName).
      // Points, landmarkId, userId, etc. stay immutable so scores can't be
      // tampered with. The admin account gets one extra allowance -- fixing
      // createdAt on ANY check-in (Admin Mode's "change when I checked in"),
      // still nothing else, on anyone's check-in, not just their own.
      allow update: if request.auth != null
        && (
          (checkinId.split('_')[0] == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL', 'photoURLs', 'userName']))
          || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt']))
        );
      allow delete: if false;
    }
    // Id is always "{period}_{periodKey}_{uid}" (see leaderboard.js). Before,
    // any signed-in account could write any entry id with any points, which
    // also let it overwrite (erase) someone else's entry. Now: your own id
    // only, and points only ever go up, by at most one payout per write.
    match /leaderboard_entries/{entryId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && entryId.matches('(weekly|monthly|yearly)_[0-9W-]+_' + request.auth.uid)
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'period', 'periodKey', 'points', 'updatedAt'])
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.points <= maxPointsPerWrite()
        && request.resource.data.get('userName', '') is string
        && request.resource.data.get('userName', '').size() <= 200;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userName', 'points', 'updatedAt'])
        && request.resource.data.points is number
        && request.resource.data.points >= resource.data.points
        && request.resource.data.points <= resource.data.points + maxPointsPerWrite()
        && request.resource.data.get('userName', '') is string
        && request.resource.data.get('userName', '').size() <= 200;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Your own profile only. On top of ownership, a few fields other people
    // rely on are pinned: `email` must be your real sign-in email (friends
    // search by it, and the feature-request notification finds the admin by
    // it), `username` must be one you actually hold in usernames/, bonus
    // points only go up by one bonus at a time, and privilege-looking fields
    // can't be set at all (nothing reads them today; this keeps it that way).
    function profileFieldsOk() {
      let d = request.resource.data;
      let changed = resource == null ? d.keys() : d.diff(resource.data).affectedKeys();
      return !d.keys().hasAny(['isAdmin', 'admin', 'role', 'roles', 'isVerified', 'verified', 'moderator'])
        && (!changed.hasAny(['uid']) || d.uid == request.auth.uid)
        && (!changed.hasAny(['email']) || d.email == request.auth.token.email.lower())
        && (!changed.hasAny(['username'])
            || getAfter(/databases/$(database)/documents/usernames/$(d.username)).data.uid == request.auth.uid)
        && (!changed.hasAny(['bonusPoints'])
            || (d.bonusPoints is number
                && d.bonusPoints >= (resource == null ? 0 : resource.data.get('bonusPoints', 0))
                && d.bonusPoints <= (resource == null ? 0 : resource.data.get('bonusPoints', 0)) + maxPointsPerWrite()));
    }
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && profileFieldsOk();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && name.matches('[a-z0-9_]{3,20}')
        && request.resource.data.keys().hasOnly(['uid']);
      // The client re-writes its own username doc on save even when it
      // already exists (e.g. re-submitting the same name, or touching other
      // fields) -- that's an update in Firestore's terms since the doc
      // already exists, which was never granted before.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /friend_requests/{id} {
      allow read, delete: if request.auth != null
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      // Id pinned to "{from}_{to}" so friend_edges below can trust it.
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
        && id == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.to != request.auth.uid
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.to + '_' + request.resource.data.from))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.from + '_' + request.resource.data.to));
    }

    // id is always the referred user's own uid -- at most one referral doc
    // per account, so nobody can rack up bonuses "signing up" repeatedly.
    // Each side (referrer, referred) can only ever flip its own uid's claim
    // flag, and only once each field is created false -- see item i8.
    match /referrals/{id} {
      allow get: if request.auth != null && (id == request.auth.uid || resource.data.referrerUid == request.auth.uid);
      allow list: if request.auth != null && resource.data.referrerUid == request.auth.uid;
      allow create: if request.auth != null
        && id == request.auth.uid
        && request.resource.data.referredUid == request.auth.uid
        && request.resource.data.referrerUid != request.auth.uid
        && request.resource.data.referredClaimed == false
        && request.resource.data.referrerClaimed == false;
      allow update: if request.auth != null
        && (
          (id == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referredClaimed'])
            && request.resource.data.referredClaimed == true)
          || (resource.data.referrerUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referrerClaimed'])
              && request.resource.data.referrerClaimed == true)
        );
      allow delete: if false;
    }

    // id is always "{blockerUid}_{blockedUid}". Read/list/delete are scoped
    // to your own outgoing blocks; other rules below use exists() on a
    // specific id to check a block regardless of these rules (exists()/get()
    // bypass the target collection's own rules, same as the users/public
    // check on reviews further down).
    match /blocks/{id} {
      allow get: if request.auth != null && id.split('_')[0] == request.auth.uid;
      allow list: if request.auth != null && resource.data.blockerUid == request.auth.uid;
      allow create: if request.auth != null
        && id == request.auth.uid + '_' + request.resource.data.blockedUid
        && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if request.auth != null && id.split('_')[0] == request.auth.uid;
    }
    match /friend_edges/{id} {
      // get: id is always "{ownerUid}_{friendUid}" (the client checks for an
      // edge's existence before it exists, to decide whether to send a
      // friend request) -- checking resource.data.owner crashes with
      // "permission denied" instead of a clean not-found when the doc
      // doesn't exist yet, since resource is null. Checking the id itself
      // works either way.
      allow get: if request.auth != null && id.split('_')[0] == request.auth.uid;
      // list: the client also queries where('owner','==',uid) to load "my
      // friends" -- Firestore can only verify a list query against a rule
      // that mirrors the query's own field filter, not an id-based check, so
      // this needs the resource.data version specifically (using the id
      // version here silently rejects the whole query instead).
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      // Only the person accepting a real, pending friend request can create
      // the pair of edges (acceptRequest in friends.js). Before, any account
      // could write friend_edges/{self}_{anyone} on its own and instantly read
      // that person's friends-only reviews and photos.
      allow create: if request.auth != null
        && id == request.resource.data.owner + '_' + request.resource.data.friend
        && (
          (request.resource.data.owner == request.auth.uid && pendingRequest(request.resource.data.friend, request.auth.uid))
          || (request.resource.data.friend == request.auth.uid && pendingRequest(request.resource.data.owner, request.auth.uid))
        );
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    match /reviews/{reviewId} {
      // A review (comment, stars, photos) is visible to: its own author, a
      // friend of the author, or anyone at all if the author's account is
      // public (users/{uid}.public == true, set via the Profile page's
      // Privacy toggle -- default is private/friends-only). That's the
      // `get` rule; it can't serve list queries (Firestore rejects a whole
      // query it can't prove safe rather than filtering it), so lists have
      // their own rule below. exists() is checked before get() so a reviewer who somehow
      // has no users/{uid} doc yet fails safe (denied) instead of erroring.
      // Hidden once REPORT_HIDE_THRESHOLD (2) distinct people have reported
      // it -- unless you're the author or an admin -- and hidden from
      // either side of a block, on top of the existing visibility check.
      //
      // resource == null first: submitReview's transaction always reads this
      // doc before writing it (to know whether it's a new rating or an edit),
      // and for a landmark's first-ever rating the doc doesn't exist yet --
      // resource is null then, so resource.data.userId below would otherwise
      // throw inside the rule itself. Firestore treats a thrown rule as a
      // hard deny, not the clean "not found" a missing doc should be, which
      // made every first-time rating fail with permission-denied.
      allow get: if
        resource == null
        || (
          (exists(/databases/$(database)/documents/users/$(resource.data.userId))
            && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('public', false) == true)
          || (request.auth != null
              && (reviewId.split('_')[0] == request.auth.uid
                  || exists(/databases/$(database)/documents/friend_edges/$(request.auth.uid + '_' + resource.data.userId))))
        )
        && (
          resource.data.get('reportedBy', []).size() < 2
          || (request.auth != null
              && (reviewId.split('_')[0] == request.auth.uid || isAdmin()))
        )
        && !(request.auth != null
          && (exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + resource.data.userId))
              || exists(/databases/$(database)/documents/blocks/$(resource.data.userId + '_' + request.auth.uid))));
      // List queries (a landmark's Comments, your own reviews). Firestore
      // only allows a query it can prove returns nothing this viewer can't
      // see, and it can't look up every author's privacy setting mid-query,
      // so a list uses the review's own copy of it (`visibility`, kept in
      // sync by the author) plus `hidden`. Three query shapes pass: your own
      // (userId == you), public ones (visibility == 'public', hidden ==
      // false), and one friend's (userId == friend, hidden == false). Block
      // filtering for lists happens in the app; a direct get still enforces
      // blocks and the author's live privacy setting above.
      allow list: if
        (request.auth != null && resource.data.userId == request.auth.uid)
        || (resource.data.get('hidden', true) == false
            && (resource.data.get('visibility', 'private') == 'public'
                || (request.auth != null
                    && exists(/databases/$(database)/documents/friend_edges/$(request.auth.uid + '_' + resource.data.userId)))));
      allow create: if request.auth != null
        && reviewId == request.auth.uid + '_' + request.resource.data.landmarkId
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['reportedBy'])
        && request.resource.data.get('comment', '').size() <= 500
        && reviewHiddenOk(request.resource.data)
        && reviewVisibilityOk(request.resource.data)
        && exists(/databases/$(database)/documents/checkins/$(reviewId));
      // Two ways to update: the author editing their own review (unchanged),
      // or someone else reporting it -- which may ONLY append their own uid
      // to reportedBy, exactly once, touching no other field. That, plus
      // "each uid appears at most once," is what makes the read rule above
      // an actual server-side enforcement instead of a client-side filter.
      allow update: if request.auth != null
        && (
          // The author can't clear reportedBy to un-hide a reported review.
          (reviewId == request.auth.uid + '_' + request.resource.data.landmarkId
            && request.resource.data.userId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reportedBy', 'userId'])
            && request.resource.data.get('comment', '').size() <= 500
            && reviewHiddenOk(request.resource.data)
            && reviewVisibilityOk(request.resource.data)
            && exists(/databases/$(database)/documents/checkins/$(reviewId)))
          || (
            reviewId.split('_')[0] != request.auth.uid
            && !(resource.data.get('reportedBy', []).hasAny([request.auth.uid]))
            && request.resource.data.reportedBy == resource.data.get('reportedBy', []).concat([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy', 'hidden'])
            && reviewHiddenOk(request.resource.data)
          )
        );
      allow delete: if request.auth != null && reviewId.split('_')[0] == request.auth.uid;
    }
    match /reviews/{reviewId}/replies/{replyId} {
      // Same visibility as the review itself -- a reply thread on a
      // friends-only or private review shouldn't be more exposed than the
      // review it's attached to.
      allow read: if reviewVisible(reviewId);
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'userName', 'text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      // The reply's own author, the review's author (moderating their own
      // thread), or an admin can remove a reply. No editing in v1.
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || reviewId.split('_')[0] == request.auth.uid
            || isAdmin());
    }
    // ✓ / ✗ on a Mapr pick ("I'd go" / "not for me"). Private to its
    // owner; one doc per user+landmark, so the id is pinned to both.
    match /pick_feedback/{id} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.landmarkId
        // 'unsure' is a real, common verdict (pickFeedback.js) -- leaving it
        // out here meant every "Not sure" vote silently failed to sync to
        // Firestore (caught by the client's own try/catch) and only ever
        // lived in that one device's localStorage.
        && request.resource.data.verdict in ['yes', 'no', 'unsure'];
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    // Dual streaks (Dual Streak spec, phase 3 MVP -- see pairStreaks.js).
    // count/best/lastCompletedDay are server-authority only: a client can
    // create the pair at zero and can never touch them again after that --
    // only api/close-streak-day.js (firebase-admin, bypasses these rules
    // entirely) ever changes them.
    match /streaks/{pairId} {
      // Checked against the id itself (pairId is always "{uidA}_{uidB}",
      // sorted -- see pairIdOf), not resource.data: startStreak() does a
      // getDoc() BEFORE the doc exists to check whether the pair is already
      // streaking, and resource is null for a nonexistent doc -- the same
      // class of bug #147 hit for reviews (a rule that dereferences
      // resource.data before checking it exists is a hard deny, not a clean
      // not-found). `read` covers both that get and the array-contains list
      // query (subscribeMyStreaks); for list, pairId is still each matched
      // document's own id, so this works the same way there too.
      allow read: if request.auth != null
        && (pairId.split('_')[0] == request.auth.uid || pairId.split('_')[1] == request.auth.uid);
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 2
        && pairId == request.resource.data.memberIds[0] + '_' + request.resource.data.memberIds[1]
        && request.resource.data.count == 0
        && request.resource.data.best == 0
        && request.resource.data.lastCompletedDay == null;
      allow update: if false;
      // Guardrail (item b2/11): anyone in the pair can leave, no penalty.
      allow delete: if request.auth != null && request.auth.uid in resource.data.memberIds;

      match /days/{dayId}/entries/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/streaks/$(pairId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/streaks/$(pairId)).data.memberIds;
        allow delete: if false;
      }
    }
    // One doc per real Mapr chat reply that produced stops -- backs the
    // "time saved" stat (src/lib/timeSaved.js). Auto-id (many per user per
    // day), private to its owner, write-once -- nothing about a logged
    // generation time or stop count should ever be edited after the fact.
    match /planning_events/{id} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.minutesSaved is number
        && request.resource.data.minutesSaved >= 0;
      allow update, delete: if false;
    }
    // Running per-landmark check-in counts for one region (Mapr Picks' cold
    // start ranks by these). Same trust level as landmark_ratings below.
    match /region_stats/{region} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['counts', 'backfilled', 'updatedAt']);
    }
    // Running rating aggregate per landmark. Only moves together with your
    // own review for that landmark in the same transaction (submitReview /
    // deleteMyReview): +1 count when your review is new, 0 on an edit, -1
    // when it's deleted, and the star sum by at most one review's worth.
    // Before, any signed-in account could set any landmark to 5.0 or wipe it.
    match /landmark_ratings/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['landmarkId', 'sum', 'count', 'avg', 'updatedAt'])
        && request.resource.data.sum is number
        && request.resource.data.count is number
        && request.resource.data.count >= 0
        && request.resource.data.sum >= 0
        && ratingDeltaOk(id,
             request.resource.data.count - (resource == null ? 0 : resource.data.get('count', 0)),
             request.resource.data.sum - (resource == null ? 0 : resource.data.get('sum', 0)));
      allow delete: if false;
    }
    function ratingDeltaOk(landmarkId, countDelta, sumDelta) {
      let review = /databases/$(database)/documents/reviews/$(request.auth.uid + '_' + landmarkId);
      return sumDelta >= -5 && sumDelta <= 5
        && (
          (countDelta == 1 && !exists(review) && existsAfter(review))
          || (countDelta == 0 && existsAfter(review))
          || (countDelta == -1 && exists(review) && !existsAfter(review))
        );
    }
    // "Move pins" on the map: Admin Mode only can correct a built-in
    // landmark's position for everyone. Shape-checked so it can only ever
    // hold a position, stamped with who moved it.
    match /landmark_overrides/{id} {
      allow read: if true;
      allow create, update: if request.auth != null && isAdmin()
        && id == request.resource.data.region + '__' + request.resource.data.id
        && request.resource.data.keys().hasOnly(['region', 'id', 'name', 'lat', 'lng', 'updatedAt', 'updatedBy'])
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 200;
      allow delete: if isAdmin();
    }
    // Admin Mode's live corrections to a built-in (static catalog)
    // landmark -- name/category/summary/facts/free/typicalMinutes/images,
    // merged over the static src/data/landmarks.*.js data at render time.
    // Admin-only, same as landmark_overrides just above.
    match /landmark_edits/{id} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    match /custom_landmarks/{id} {
      // Same reportedBy hide-past-threshold rule as reviews, unless you're
      // the submitter or an admin.
      allow read: if resource.data.get('reportedBy', []).size() < 2
        || (request.auth != null
            && (resource.data.createdBy == request.auth.uid || isAdmin()));
      // A brand-new submission always starts "pending" -- enforced here, not
      // just in the app's own code, so calling the database directly can't
      // skip the approval queue and self-publish as "approved".
      // Matches the server-side gate in api/verify-landmark.js (verified
      // email), which the app calls first -- without this, writing to the
      // database directly skipped it. Shape and sizes are pinned too.
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && id == request.resource.data.id
        && request.resource.data.keys().hasOnly(['region', 'id', 'name', 'lat', 'lng', 'categories', 'images',
             'summary', 'facts', 'free', 'typicalMinutes', 'hours', 'status', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.get('summary', '').size() <= 2000
        && request.resource.data.get('images', []).size() <= 10
        && request.resource.data.get('facts', []).size() <= 20
        && request.resource.data.get('categories', []).size() <= 10
        && request.resource.data.get('hours', '').size() <= 200;
      // An admin can change status (approve) or anything else. Anyone else
      // (not the submitter) may only report it -- same restricted
      // reportedBy-append as reviews above.
      allow update: if request.auth != null
        && (
          isAdmin()
          || (
            resource.data.createdBy != request.auth.uid
            && !(resource.data.get('reportedBy', []).hasAny([request.auth.uid]))
            && request.resource.data.reportedBy == resource.data.get('reportedBy', []).concat([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy'])
          )
        );
      // Only the original submitter or an admin can delete a submission --
      // any other signed-in account could wipe any landmark before this.
      allow delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Profile's "Request a Feature" -- anyone signed in can submit one
    // (always starting "pending", same enforced-not-just-client-side
    // pattern as custom_landmarks above); only the submitter or an admin
    // can read it back, and only an admin can flip its status via the
    // Approve/Reject Features tab.
    match /feature_requests/{id} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    // A trip a few friends build together (item i6). Only current members
    // can see or touch it at all; only the owner can change who's a member
    // (add/remove), while any member can edit the shared landmark list --
    // two separate permissions enforced by which fields a write touches.
    function groupTripFieldsOk() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.memberUids.size() <= 25
        && d.get('places', []).size() <= 60;
    }
    match /group_trips/{tripId} {
      allow get: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow list: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && groupTripFieldsOk();
      // Any member: edit the shared lists (catalog landmarks and places Mapr
      // found on the web), rename the trip, and invite people (only ever
      // adding -- the member list can grow, never shrink). Only the owner
      // can remove members.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberUids
        && groupTripFieldsOk()
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['landmarkIds', 'places', 'name'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberNames', 'name'])
              && request.resource.data.memberUids.hasAll(resource.data.memberUids))
          || (request.auth.uid == resource.data.ownerUid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberNames', 'name'])
              && request.resource.data.ownerUid in request.resource.data.memberUids)
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // Mapr chats and projects (src/lib/maprChats.js). A chat's memberUids
    // always equals its project's memberUids, or just its owner when it's in
    // no project -- so sharing a project shares its chats, and one
    // array-contains query lists everything a person can see.
    function maprProject(id) {
      return get(/databases/$(database)/documents/mapr_projects/$(id)).data;
    }
    function maprChatShapeOk() {
      let d = request.resource.data;
      return d.ownerUid is string
        && d.memberUids is list && d.memberUids.size() >= 1 && d.memberUids.size() <= 25
        && d.ownerUid in d.memberUids
        && d.title is string && d.title.size() <= 120
        && d.messagesJson is string && d.messagesJson.size() <= 900000
        && d.regionIds is list && d.regionIds.size() <= 30
        && (d.projectId == null || d.projectId is string);
    }
    function maprChatMembersOk() {
      let d = request.resource.data;
      return d.projectId == null
        ? d.memberUids == [d.ownerUid]
        : (exists(/databases/$(database)/documents/mapr_projects/$(d.projectId))
           && d.memberUids == maprProject(d.projectId).memberUids);
    }
    match /mapr_chats/{id} {
      allow get, list: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && maprChatShapeOk()
        && maprChatMembersOk();
      // (Members-match plus owner-in-members means you can only start a
      // chat in a project you belong to.)
      allow update: if request.auth != null
        && request.resource.data.ownerUid == resource.data.ownerUid
        && maprChatShapeOk()
        && maprChatMembersOk()
        && (
          // Your own chat: anything, including moving it between projects
          // you belong to.
          (request.auth.uid == resource.data.ownerUid
            && (request.resource.data.projectId == null
                || request.auth.uid in maprProject(request.resource.data.projectId).memberUids))
          // Someone's chat in a project you're in: continue it, rename it,
          // or (the project owner) re-sync its members.
          || (resource.data.projectId != null
              && request.resource.data.projectId == resource.data.projectId
              && request.auth.uid in resource.data.memberUids)
          // The project owner sends a chat back to its owner (removing that
          // person, or deleting the project).
          || (resource.data.projectId != null
              && request.resource.data.projectId == null
              && exists(/databases/$(database)/documents/mapr_projects/$(resource.data.projectId))
              && request.auth.uid == maprProject(resource.data.projectId).ownerUid)
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }
    function maprProjectShapeOk() {
      let d = request.resource.data;
      return d.ownerUid is string
        && d.memberUids is list && d.memberUids.size() >= 1 && d.memberUids.size() <= 25
        && d.ownerUid in d.memberUids
        && d.memberNames is map
        && d.name is string && d.name.size() <= 120
        && d.instructions is string && d.instructions.size() <= 4000;
    }
    match /mapr_projects/{id} {
      allow get, list: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && maprProjectShapeOk();
      // Members can rename it and edit its instructions; only the owner
      // changes who's in it.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.ownerUid == resource.data.ownerUid
        && maprProjectShapeOk()
        && (request.auth.uid == resource.data.ownerUid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'instructions', 'updatedAt']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // In-app notifications (item i2's non-push slice -- see the lib file for
    // why this project can't wire up real push yet). Only the owning uid can
    // ever read them; an admin can also create one for someone else (e.g.
    // "your submission was approved"). A regular account can additionally
    // notify a fellow member of a real group_trips doc (e.g. "you were
    // added to a group trip") -- both the writer and the notified uid must
    // already be members of that same trip, which by write order (member
    // added first, notification second) is only ever true right after a
    // real invite. A regular account can also notify the admin specifically
    // (never anyone else) about a new "Request a Feature" submission --
    // resolved by the target uid's OWN users/{uid}.email rather than a
    // hardcoded uid, so this doesn't need updating if the admin account
    // ever changes. Nothing lets one regular account write into another's
    // notifications outside those two cases.
    match /notifications/{id} {
      allow get, list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && (request.resource.data.uid == request.auth.uid
            || isAdmin()
            || (request.resource.data.type == 'group_invite'
                && exists(/databases/$(database)/documents/group_trips/$(request.resource.data.groupTripId))
                && request.auth.uid in
                   get(/databases/$(database)/documents/group_trips/$(request.resource.data.groupTripId)).data.memberUids
                && request.resource.data.uid in
                   get(/databases/$(database)/documents/group_trips/$(request.resource.data.groupTripId)).data.memberUids)
            || (request.resource.data.type == 'mapr_project_invite'
                && exists(/databases/$(database)/documents/mapr_projects/$(request.resource.data.maprProjectId))
                && request.auth.uid ==
                   get(/databases/$(database)/documents/mapr_projects/$(request.resource.data.maprProjectId)).data.ownerUid
                && request.resource.data.uid in
                   get(/databases/$(database)/documents/mapr_projects/$(request.resource.data.maprProjectId)).data.memberUids)
            || (request.resource.data.type == 'feature_request'
                && exists(/databases/$(database)/documents/users/$(request.resource.data.uid))
                && get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.get('email', '')
                   in ['landymontiel25@gmail.com']));
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
