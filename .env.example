VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only (no VITE_ prefix -- never sent to the client bundle). Powers
# the /api/* AI endpoints: the "Ask AI" widget, trip planning, custom
# interest matching, and landmark-submission verification. Get one at
# https://console.anthropic.com/settings/keys. Without it, those features
# show a "not set up yet" message -- everything else works fine.
ANTHROPIC_API_KEY=

# Server-only (no VITE_ prefix -- never sent to the client bundle). Powers
# the address search box on Add Landmark and Trip Setup via /api/places-*
# (Google Places API (New): Autocomplete + Place Details, Essentials tier
# only). Get one at https://console.cloud.google.com/apis/credentials, with
# the "Places API (New)" enabled. Without it, that search box shows a
# "not set up yet" message -- everything else works fine.
GOOGLE_PLACES_API_KEY=

# Native (iOS) app only: where the app finds the /api/* functions, since
# its own origin is capacitor://localhost. Your deployed site, e.g.
# https://landmark-hunters.vercel.app. Leave blank for web-only work. Set it
# before `npm run ios:sync`.
VITE_API_BASE_URL=

# ---- Server-only, read by the /api/* functions (set these in Vercel) ----
# Service account JSON (the whole file contents, one line) for the Admin SDK: push, stats, Mapr jobs.
FIREBASE_SERVICE_ACCOUNT=
# Bearer secret Vercel Cron sends to /api/mapr-nightly and /api/study-summary.
CRON_SECRET=
# Shared secret the admin dashboard's server sends to /api/admin-jobs.
ADMIN_JOBS_SECRET=
# Admin dashboard URL, linked from the nightly Slack message (optional).
DASHBOARD_URL=
# Slack incoming webhook for the nightly Mapr summary (optional; no message without it).
SLACK_WEBHOOK_URL=
# Google Routes API key for /api/directions; without it directions say "not set up yet".
GOOGLE_ROUTES_API_KEY=
