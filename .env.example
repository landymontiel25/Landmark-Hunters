VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only (no VITE_ prefix -- never sent to the client bundle). Powers
# the /api/* AI endpoints: the "Ask AI" widget, trip planning, custom
# interest matching, and landmark-submission verification. Get one at
# https://console.anthropic.com/settings/keys. Without it, those features
# show a "not set up yet" message -- everything else works fine.
ANTHROPIC_API_KEY=

# Server-only (no VITE_ prefix -- never sent to the client bundle). Powers
# the address search box on Add Landmark and Trip Setup via /api/places-*
# (Google Places API (New): Autocomplete + Place Details, Essentials tier
# only). Get one at https://console.cloud.google.com/apis/credentials, with
# the "Places API (New)" enabled. Without it, that search box shows a
# "not set up yet" message -- everything else works fine.
GOOGLE_PLACES_API_KEY=

# The same GOOGLE_PLACES_API_KEY also powers /api/landmark-ratings (Google
# rating, review count and reviews on landmarks; docs/ratings.md). That needs
# the key's project to allow Place Details Enterprise fields (rating,
# userRatingCount, googleMapsUri, reviews), which bill at a higher tier.

# Server-only. Tripadvisor ratings on landmarks via /api/landmark-ratings and
# scripts/match-rating-sources.mjs. A Tripadvisor Terra API key (the
# legacy Content API is deprecated): sign up at
# https://www.tripadvisor.com/developers, then add each matched location
# ID to your Terra allowlist. Without it, Tripadvisor rows stay hidden.
TRIPADVISOR_API_KEY=

# Browser key for Google's map on the Map tab (Map Tiles API; docs/google-map.md).
# It ships to the browser inside tile URLs, so in Google Cloud restrict it to
# the "Map Tiles API" only and to your site's referrers, and set a daily
# quota. Blank keeps the Esri/Carto map (and no Google ratings in pin popups).
VITE_GOOGLE_MAP_TILES_KEY=

# reCAPTCHA Enterprise site key for Firebase App Check (docs/rate-limits.md).
# Web only; blank leaves App Check off. Restrict it to your site's domains.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Native (iOS) app only: where the app finds the /api/* functions, since
# its own origin is capacitor://localhost. Your deployed site, e.g.
# https://landmark-hunters.vercel.app. Leave blank for web-only work. Set it
# before `npm run ios:sync`.
VITE_API_BASE_URL=

# ---- Server-only, read by the /api/* functions (set these in Vercel) ----
# Service account JSON (the whole file contents, one line) for the Admin SDK: push, stats, Mapr jobs.
FIREBASE_SERVICE_ACCOUNT=
# Bearer secret Vercel Cron sends to /api/mapr-nightly and /api/study-summary.
CRON_SECRET=
# Shared secret the admin dashboard's server sends to /api/admin-jobs.
ADMIN_JOBS_SECRET=
# Admin dashboard URL, linked from the nightly Slack message (optional).
DASHBOARD_URL=
# Slack incoming webhook for the nightly Mapr summary (optional; no message without it).
SLACK_WEBHOOK_URL=
# Google Routes API key for /api/directions; without it directions say "not set up yet".
GOOGLE_ROUTES_API_KEY=
# App Check on /api/*: off (default), monitor (log only) or enforce (docs/rate-limits.md).
APP_CHECK_MODE=
# Firebase project number for App Check; falls back to VITE_FIREBASE_MESSAGING_SENDER_ID.
FIREBASE_PROJECT_NUMBER=
# Daily caps across all users (api/_lib/usageQuota.js); blank keeps the defaults there.
AI_DAILY_GLOBAL_CAP=
