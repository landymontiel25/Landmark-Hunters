 {
  "id": "osm-n8083426867",
  "name": "El Polin Spring",
  "address": "El Polin Loop",
  "city": "San Francisco",
  "facts": [
   {
    "text": "Provided fresh water to the Ramaytush Ohlone, Spanish soldiers and the U.S. Army.",
    "url": "https://presidio.gov/explore/attractions/el-polin-spring"
   },
   {
    "text": "By 1812 colonial families had adobe houses here, making it San Francisco's first suburb.",
    "url": "https://presidio.gov/explore/attractions/el-polin-spring"
   },
   {
    "text": "Juana Briones lived here with her family in the early 1800s.",
    "url": "https://presidio.gov/explore/attractions/el-polin-spring"
   }
  ]
 },
