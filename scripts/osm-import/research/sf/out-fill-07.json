[{"name": "Burma Superstar", "area": "Inner Richmond", "address": "309 Clement St", "city": "San Francisco", "tier": "everyday", "matched": true, "closed": false, "closedSource": null, "notFound": false, "searches": 2, "reason": null, "facts": [{"text": "Opened its original Clement Street location in 1992.", "url": "https://www.burmasuperstar.com/heritage"}, {"text": "Has since opened additional locations in Alameda and Oakland.", "url": "https://www.burmasuperstar.com/heritage"}]}, {"name": "Toy Boat Dessert Cafe", "area": "Inner Richmond", "address": "401 Clement St", "city": "San Francisco", "tier": "everyday", "matched": true, "closed": false, "closedSource": null, "notFound": false, "searches": 2, "reason": null, "facts": [{"text": "Jesse Fink opened it in 1982 with his girlfriend at the time, Roberta.", "url": "https://jweekly.com/2020/06/08/after-38-years-gregarious-toy-boat-dessert-cafe-owner-sets-sail/"}, {"text": "The cafe had vintage toys and a 1950s mechanical horse named Butterscotch that kids could ride.", "url": "https://jweekly.com/2020/06/08/after-38-years-gregarious-toy-boat-dessert-cafe-owner-sets-sail/"}, {"text": "Reopened in June 2025 as Toy Boat by Jane, with baked goods from Jane.", "url": "https://hoodline.com/2025/06/clement-street-ice-cream-nostalgia-gem-toy-boat-by-jane-reopens-in-sf/"}]}, {"name": "Pizzetta 211", "area": "Outer Richmond", "address": "211 23rd Ave", "city": "San Francisco", "tier": "everyday", "matched": true, "closed": false, "closedSource": null, "notFound": false, "searches": 2, "reason": null, "facts": [{"text": "Serves thin-crust pizzettas on a menu that changes every two weeks.", "url": "https://www.pizzetta211.com/weekly-menu"}, {"text": "Opened in 1999 by Ria Ramsey and Sher Rogat, neither formally trained as chefs.", "url": "https://goop.com/place/california/san-francisco/richmond-district-restaurants/pizzetta-211/"}]}, {"name": "Hong Kong Lounge", "area": "Outer Richmond", "address": "5322 Geary Blvd", "city": "San Francisco", "tier": "everyday", "matched": true, "closed": false, "closedSource": null, "notFound": false, "searches": 2, "reason": null, "facts": [{"text": "Serves Cantonese dim sum including baked pork buns, siu mai and fried sticky rice.", "url": "https://www.theinfatuation.com/san-francisco/reviews/hong-kong-lounge"}, {"text": "Offers Peking duck on demand, in half or whole orders.", "url": "https://www.theinfatuation.com/san-francisco/reviews/hong-kong-lounge"}]}, {"name": "Breadbelly", "area": "Inner Richmond", "address": "1408 Clement St", "city": "San Francisco", "tier": "everyday", "matched": true, "closed": false, "closedSource": null, "notFound": false, "searches": 2, "reason": null, "facts": [{"text": "Founded by chefs James Wong, Clement Hsu and Katherine Campecino-Wong, who come from fine dining.", "url": "https://www.breadbellysf.com/about"}, {"text": "Serves kaya toast, coconut jam piped on house-baked milk bread.", "url": "https://www.breadbellysf.com/info/kaya-toast"}, {"text": "Has a second location in Dogpatch.", "url": "https://www.breadbellysf.com/location"}]}, {"name": "Beach Chalet", "area": "Outer Richmond", "address": "1000 Great Highway", "city": "San Francisco", "tier": "everyday", "matched": true, "closed": false, "closedSource": null, "notFound": false, "searches": 1, "reason": null, "facts": [{"text": "Designed by architect Willis Polk and opened in 1925 as a city-run restaurant with beach changing rooms.", "url": "https://en.wikipedia.org/wiki/Beach_Chalet"}, {"text": "The first-floor fresco murals were painted by Lucien Labaudt in 1936 and 1937 as a WPA project.", "url": "https://livingnewdeal.org/sites/beach-chalet-fresco-mural-cycle-san-francisco-ca/"}, {"text": "It is San Francisco City Landmark #179.", "url": "https://noehill.com/sf/landmarks/sf179.asp"}]}, {"name": "Mile Rock Beach", "area": "Lands End", "address": "Lands End Trail", "city": "San Francisco", "tier": "everyday", "matched": true, "closed": false, "closedSource": null, "notFound": false, "searches": 1, "reason": null, "facts": [{"text": "The beach sits between the gun fortifications of Battery Lands End and the searchlight of Battery Buck.", "url": "https://www.nps.gov/goga/learn/historyculture/vestiges-lands-end-trail.htm"}, {"text": "A spur trail from the Lands End trail leads to Mile Rock Point and views of the Golden Gate.", "url": "https://www.nps.gov/places/000/lands-end-trailhead.htm"}]}, {"name": "Eagle's Point Overlook", "area": "Lands End", "address": "Lands End Coastal Trail", "city": "San Francisco", "tier": "everyday", "matched": true, "closed": false, "closedSource": null, "notFound": false, "searches": 1, "reason": null, "facts": [{"text": "The Lands End stretch of the Coastal Trail runs from the Merrie Way lot to Eagle Point Overlook near Sea Cliff.", "url": "https://www.nps.gov/goga/planyourvisit/landsend.htm"}, {"text": "Past Eagles Point the Coastal Trail follows the 1880s roadbed of the Ferries and Cliffhouse Railroad.", "url": "https://www.nps.gov/places/000/eagle-point-trailhead.htm"}]}, {"name": "USS San Francisco Memorial", "area": "Lands End", "address": "Lands End Coastal Trail", "city": "San Francisco", "tier": "everyday", "matched": true, "closed": false, "closedSource": null, "notFound": false, "searches": 1, "reason": null, "facts": [{"text": "A shrapnel-scarred piece of the cruiser's bridge stands here with plaques and a flagpole.", "url": "https://www.nps.gov/places/000/uss-san-francisco-memorial.htm"}, {"text": "The cruiser took 45 hits and 25 fires at the Battle of Guadalcanal in 1942.", "url": "https://www.nps.gov/places/000/uss-san-francisco-memorial.htm"}]}, {"name": "Mountain Lake Park", "area": "Inner Richmond", "address": "Lake St", "city": "San Francisco", "tier": "everyday", "matched": true, "closed": false, "closedSource": null, "notFound": false, "searches": 1, "reason": null, "facts": [{"text": "A 15.2-acre park between the Presidio to the north and Lake Street to the south.", "url": "https://sfrecpark.org/facilities/facility/details/Mountain-Lake-Park-189"}, {"text": "Its playground was renovated with the 2012 Clean and Safe Neighborhood Parks Bond.", "url": "https://sfrecpark.org/570/Mountain-Lake-Park-Playground-Improvemen"}, {"text": "Has nature trails and a dog play area among wooded knolls.", "url": "https://sfrecpark.org/676/Mountain-Lake-Park-Dog-Play-Area"}]}, {"name": "China Beach", "area": "Sea Cliff", "address": "Sea Cliff Ave", "city": "San Francisco", "tier": "everyday", "matched": true, "closed": false, "closedSource": null, "notFound": false, "searches": 1, "reason": null, "facts": [{"text": "A small cove between Lands End and Baker Beach with a picnic area and views of the Marin Headlands.", "url": "https://www.parksconservancy.org/parks/china-beach"}, {"text": "Local legend says it was named for Chinese fishermen who anchored their junks in the cove.", "url": "https://www.parksconservancy.org/parks/china-beach"}]}, {"name": "Camera Obscura", "area": "Lands End", "address": "1096 Point Lobos Ave", "city": "San Francisco", "tier": "everyday", "matched": true, "closed": false, "closedSource": null, "notFound": false, "searches": 1, "reason": null, "facts": [{"text": "Floyd Jennings built the Giant Camera in 1946 as part of the Playland At The Beach amusement park.", "url": "https://en.wikipedia.org/wiki/Camera_Obscura_(San_Francisco)"}, {"text": "It was added to the National Register of Historic Places on April 20, 2001.", "url": "https://noehill.com/sf/landmarks/nat2001000522.asp"}]}, {"name": "Lincoln Park Golf Course", "area": "Lincoln Park", "address": "300 Legion of Honor Dr", "city": "San Francisco", "tier": "everyday", "matched": true, "closed": false, "closedSource": null, "notFound": false, "searches": 1, "reason": null, "facts": [{"text": "The full 18-hole course was finished in 1917, after a 3-hole layout in 1902.", "url": "https://sfrecpark.org/Facilities/Facility/Details/Lincoln-Park-Golf-Course-41"}, {"text": 