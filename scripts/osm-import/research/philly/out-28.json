   {
    "text": "Closed after a 51-year run.",
    "url": "https://www.phillyvoice.com/conshohocken-italian-bakery-closing-rolls-breads-tomato-pie/"
   },
   {
    "text": "Founded by Dominic Gambone and Frank Manze in a former tire shop.",
    "url": "https://www.phillyvoice.com/conshohocken-italian-bakery-closing-rolls-breads-tomato-pie/"
   },
   {
    "text": "Known for hoagie rolls used by many cheesesteak shops in the Philadelphia region.",
    "url": "https://www.phillyvoice.com/conshohocken-italian-bakery-closing-rolls-breads-tomato-pie/"
   },
   {
    "text": "Also baked kaiser rolls, bagels, tomato pies and Easter bread.",
    "url": "https://www.phillyvoice.com/conshohocken-italian-bakery-closing-rolls-breads-tomato-pie/"
   },
   {
    "text": "The Gambone family continued the bakery after Manze died in 2010.",
    "url": "https://www.phillyvoice.com/conshohocken-italian-bakery-closing-rolls-breads-tomato-pie/"
   }
