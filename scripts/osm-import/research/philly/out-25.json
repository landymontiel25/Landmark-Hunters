  "matched": true,
  "closed": false,
  "closedSource": null,
  "facts": [
   {
    "text": "Preston Reading Room Association, a Quaker group, built a facility at Railroad Avenue and Buck Lane in 1891.",
    "url": "https://haverfordhistoricalsociety.org/wp-content/uploads/places/Preston-Field-in-Haverford-Township.pdf"
   },
   {
    "text": "Richard Lloyd bought the private parcels in 1938 and donated them to the township.",
    "url": "https://haverfordhistoricalsociety.org/wp-content/uploads/places/Preston-Field-in-Haverford-Township.pdf"
   },
   {
    "text": "Six parcels became Preston Park, later renamed Preston Field by the township.",
    "url": "https://haverfordhistoricalsociety.org/wp-content/uploads/places/Preston-Field-in-Haverford-Township.pdf"
   }
  ]
