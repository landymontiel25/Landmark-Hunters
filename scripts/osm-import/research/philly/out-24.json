 {
  "id": "osm-r21281848",
  "name": "Logan Square",
  "matched": true,
  "closed": false,
  "closedSource": null,
  "facts": [
   {
    "text": "Originally Northwest Square in William Penn's 1684 plan, renamed in 1825 for statesman James Logan.",
    "url": "https://en.wikipedia.org/wiki/Logan_Circle_(Philadelphia)"
   },
   {
    "text": "Site of the Great Sanitary Fair in 1864, which Abraham Lincoln visited.",
    "url": "https://en.wikipedia.org/wiki/Logan_Circle_(Philadelphia)"
   },
   {
    "text": "Jacques Greber converted the square into a circle as part of the Benjamin Franklin Parkway plan.",
    "url": "https://en.wikipedia.org/wiki/Logan_Circle_(Philadelphia)"
   },
   {
    "text": "Added to the National Register of Historic Places in 1981.",
    "url": "https://en.wikipedia.org/wiki/Logan_Circle_(Philadelphia)"
   }
  ]
