  "id": "osm-w27474531",
  "name": "Harford Park",
  "matched": true,
  "closed": false,
  "closedSource": null,
  "facts": [
   {
    "text": "Covers 30.8 acres off Gulph Creek Road in Radnor.",
    "url": "https://www.radnor.com/Home/Components/FacilityDirectory/FacilityDirectory/22/33"
   },
   {
    "text": "Site of Harford Mansion, completed in 1880 and designed by Furness and Evans as a summer home for Judge John Hare.",
    "url": "https://www.radnor.com/Home/Components/FacilityDirectory/FacilityDirectory/22/33"
   },
   {
    "text": "Radnor Township bought the Hare Estate in 1969 and renamed Hare Park to Harford Park in 1974.",
    "url": "https://www.radnor.com/Home/Components/FacilityDirectory/FacilityDirectory/22/33"
   },
   {
    "text": "Designated a dog park in 1997.",
    "url": "https://www.radnor.com/Home/Components/FacilityDirectory/FacilityDirectory/22/33"
   }
  ]
