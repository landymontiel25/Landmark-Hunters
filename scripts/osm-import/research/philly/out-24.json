  "id": "osm-n13058728101",
  "name": "Mom Rinker's Rock",
  "matched": true,
  "closed": false,
  "closedSource": null,
  "facts": [
   {
    "text": "Scenic outlook in Wissahickon Valley Park, just north of the Walnut Lane Bridge.",
    "url": "https://en.wikipedia.org/wiki/Mom_Rinker's_Rock"
   },
   {
    "text": "Named for Molly Rinker, a bartender and spy during the American Revolutionary War.",
    "url": "https://en.wikipedia.org/wiki/Mom_Rinker's_Rock"
   },
   {
    "text": "A marble statue carved by Herman Kirn was installed there by John Welsh in 1883.",
    "url": "https://en.wikipedia.org/wiki/Mom_Rinker's_Rock"
   },
   {
    "text": "Novelist George Lippard was married on the rock in 1847.",
    "url": "https://en.wikipedia.org/wiki/Mom_Rinker's_Rock"
   }
  ]
