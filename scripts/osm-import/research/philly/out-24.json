 {
  "id": "osm-w1372037518",
  "name": "Idlewild Farm Preserve",
  "matched": true,
  "closed": false,
  "closedSource": null,
  "facts": [
   {
    "text": "Added to the National Register of Historic Places in 1983.",
    "url": "https://en.wikipedia.org/wiki/Idlewild_Farm_Complex"
   },
   {
    "text": "Welsh farmer Robert Lloyd built a one-room house on the farm in 1700.",
    "url": "https://en.wikipedia.org/wiki/Idlewild_Farm_Complex"
   },
   {
    "text": "Lawrence Saunders began the Bridlewild Trails Association on the farm in 1927.",
    "url": "https://en.wikipedia.org/wiki/Idlewild_Farm_Complex"
   },
   {
    "text": "In 1992 Dorothy Saunders gave about 21 acres of the farm to Natural Lands.",
    "url": "https://en.wikipedia.org/wiki/Idlewild_Farm_Complex"
   }
  ]
 },
