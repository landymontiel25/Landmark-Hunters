 {
  "id": "osm-n3873345276",
  "name": "Wynnewood Valley Park: Garden for the Blind",
  "matched": true,
  "closed": false,
  "closedSource": null,
  "facts": [
   {
    "text": "The Ardmore Rotary Club built and dedicated the garden in 1977.",
    "url": "https://archives.hud.gov/local/pa/goodstories/2011-05-31.cfm"
   },
   {
    "text": "Reconstruction began in 2010, and the restored garden was rededicated on May 9, 2011.",
    "url": "https://archives.hud.gov/local/pa/goodstories/2011-05-31.cfm"
   },
   {
    "text": "A $100,000 HUD Community Development Block Grant helped fund the restoration.",
    "url": "https://archives.hud.gov/local/pa/goodstories/2011-05-31.cfm"
   }
