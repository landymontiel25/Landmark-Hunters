# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables (see README.md).

# Firebase web config for the landmark-hunters-284ab project, as one line of
# JSON (Firebase Console -> Project settings -> Your apps -> Config).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=landmark-hunters-284ab
NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"...","authDomain":"landmark-hunters-284ab.firebaseapp.com","projectId":"landmark-hunters-284ab","appId":"..."}

# The password you type on /login. Make one with: openssl rand -hex 16
ADMIN_SECRET_TOKEN=
# Signs the session cookie. Make one with: openssl rand -hex 32
JWT_SECRET=

# Firebase service account JSON (the same key as the app's
# FIREBASE_SERVICE_ACCOUNT), raw JSON or base64 of it. Used only on the
# server, to mint the dashboard's Firebase sign-in.
FIRESTORE_ADMIN_KEY=

# The main app's address and the shared secret for its admin jobs
# (api/admin-jobs.js): "Run now" and the backfills on the Tools page.
APP_URL=https://landmark-hunters.vercel.app
ADMIN_JOBS_SECRET=
